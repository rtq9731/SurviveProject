  m_Script: {fileID: 11500000, guid: fb1767091748ff149874c8cbcb58daa3, type: 3}
  m_Name: Prologue_Intro
  m_EditorClassIdentifier: Survive.Domain::Survive.Narrative.SequenceSO
  id: prologue_intro
  lines:
  - speaker: "\uC6B0\uC8FC\uBCF5 AI"
    text: "\uCC29\uB959 \uC644\uB8CC. \uC131\uAC04 \uD56D\uD589\uC5D0 \uC4F8 \uC5F0\uB8CC\uB294 \uB0A8\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    holdSeconds: 3.5
  - speaker: "\uC6B0\uC8FC\uBCF5 AI"
    text: "\uAD11\uC5ED \uCE21\uB7C9 \uACB0\uACFC : \uAE30\uC900\uC774 \uB418\uB294 \uBCC4\uC774 \uD558\uB098\uB3C4 \uC7A1\uD788\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    holdSeconds: 4
  - speaker: "\uC6B0\uC8FC\uBCF5 AI"
    text: "\uC8FC\uC758 : \uC9C0\uD45C\uB97C \uB36E\uC740 \uC561\uCCB4\uAC00 \uB370\uC774\uD130\uBCA0\uC774\uC2A4\uC5D0 \uC5C6\uC2B5\uB2C8\uB2E4. \uC811\uCD09\uC744 \uD53C\uD558\uC2ED\uC2DC\uC624."
    holdSeconds: 4.5
  - speaker: "\uC6B0\uC8FC\uBCF5 AI"
    text: "\uD30C\uC77C\uB7FF\uC758 \uC0DD\uC874\uC744 \uC704\uD574 \uC8FC\uBCC0 \uD0D0\uC0C9\uC744 \uC2E4\uC2DC\uD569\uB2C8\uB2E4..."
    holdSeconds: 3.5
  lockInput: 0
  fadeSeconds: 0.3

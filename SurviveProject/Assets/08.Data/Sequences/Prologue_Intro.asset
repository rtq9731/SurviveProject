  m_Name: Prologue_Intro
  m_EditorClassIdentifier: Survive.Domain::Survive.Narrative.SequenceSO
  id: prologue_intro
  lines:
  - speaker: "\uC6B0\uC8FC\uBCF5 AI"
    text: "\uC8FC\uC758 : \uD604\uC7AC \uC0DD\uBA85 \uC720\uC9C0 \uC7A5\uCE58\uAC00
      \uC704\uD5D8 \uC0C1\uD0DC\uC785\uB2C8\uB2E4."
    holdSeconds: 3.5
  - speaker: "\uC6B0\uC8FC\uBCF5 AI"
    text: "\uD30C\uC77C\uB7FF\uC758 \uC0DD\uC874\uC744 \uC704\uD574 \uC8FC\uBCC0
      \uD0D0\uC0C9\uC744 \uC2E4\uC2DC\uD569\uB2C8\uB2E4..."
    holdSeconds: 3.5
  - speaker: "\uC6B0\uC8FC\uBCF5 AI"
    text: "\uC8FC\uC758 : \uD589\uC131\uC5D0 \uD604\uC7AC $#@%\uAE09 \uBAA8\uB798
      \uD3ED\uD48D \uC811\uADFC \uC911, \uC989\uC2DC \uCCA0\uC218\uB97C \uAD8C\uACE0\uD569\uB2C8\uB2E4."
    holdSeconds: 4.5
  - speaker: "\uC6B0\uC8FC\uBCF5 AI"
    text: "\uADFC\uCC98\uC5D0 \uC801\uC808\uD55C \uD53C\uB09C\uCC98 \uAC10\uC9C0.
      \uD45C\uC2DC\uD569\uB2C8\uB2E4..."
    holdSeconds: 3.5
  lockInput: 0
  fadeSeconds: 0.3

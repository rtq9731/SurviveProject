# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/master/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.unitypackage

# Crashlytics generated file
crashlytics-build.properties

# 개인 에디터 설정 (레이아웃·검색 인덱스·MCP 세션)
/[Uu]serSettings/

# Unity CLI Loop 산출물 (스크린샷·하이어라키 덤프·권한 설정)
/.uloop/

# 에디터 도구 설정
/.claude/

# 새 솔루션 포맷
*.slnx

# Unity 크래시 복구 사본 (에디터가 로컬에 만든 것 — 파일은 디스크에 그대로 남는다)
# 13행의 meta 되살리기 규칙보다 뒤에 와야 .meta까지 걸린다.
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta

# .unitypackage 자체가 무시 대상(56행)이니 그 meta도 무시한다.
# 13행 주석이 말하는 바로 그 경우 — "자산이 무시될 때만 meta도 무시한다".
# 이걸 안 걸어 두면 에디터를 열 때마다 Feel의 구버전 패키지 meta 셋이
# 되살아나 작업 사본이 더러워진다.
*.unitypackage.meta

